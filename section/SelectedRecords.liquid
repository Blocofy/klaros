{%- liquid
  assign color_scheme = props.color_scheme | default: 'scheme-1'
  assign cols = props.columns | default: '3'
  assign records = props.records
  assign total = records | size
-%}
<section class="section color-{{ color_scheme }}">
  <div class="wrap">
    {%- if props.heading and props.heading != blank -%}
      <div class="section__lead"><h2 data-yt-bind="heading">{{ props.heading }}</h2></div>
    {%- endif -%}

    {%- if total > 0 -%}
      <div class="grid grid--{{ cols }}">
        {%- for r in records -%}
          {%- liquid
            assign card_title = r.data[props.title_field] | default: r.title
            assign card_excerpt = r.data[props.excerpt_field]
            assign card_img = r.data[props.image_field] | default: r.og_image | image_url: 'width=600&format=webp'
          -%}
          <article class="card" style="padding:0;overflow:hidden">
            {%- if card_img and card_img != '' -%}
              <img src="{{ card_img }}" alt="{{ card_title }}" loading="lazy" style="aspect-ratio:16/10;object-fit:cover;width:100%">
            {%- endif -%}
            <div style="padding:1.5rem">
              <h3 style="margin-top:.4rem">
                {%- if props.show_link and r.url and r.url != '' -%}
                  <a href="{{ r.url }}">{{ card_title }}</a>
                {%- else -%}{{ card_title }}{%- endif -%}
              </h3>
              {%- if card_excerpt and card_excerpt != '' -%}<p>{{ card_excerpt }}</p>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif props.empty_text and props.empty_text != blank -%}
      <p style="opacity:.6">{{ props.empty_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Seçili kayıtlar",
  "category": "İçerik",
  "settings": [
    { "type": "header", "label": "İçerik" },
    { "type": "text", "id": "heading", "label": "Bölüm başlığı", "placeholder": "Seçili içerikler" },
    { "type": "entry_list", "id": "records", "label": "Kayıtlar", "limit": 12, "searchable": true },

    { "type": "header", "label": "Kart alan eşlemesi" },
    { "type": "text", "id": "title_field", "label": "Başlık alanı", "help": "Boşsa kaydın kendi başlığı kullanılır." },
    { "type": "text", "id": "image_field", "label": "Görsel alanı", "help": "Boşsa kaydın kapak görseli (og_image) denenir." },
    { "type": "text", "id": "excerpt_field", "label": "Özet alanı", "help": "Kartta gösterilecek kısa metin alanı." },

    { "type": "header", "label": "Düzen" },
    { "type": "radio", "id": "columns", "label": "Sütun", "options": [ { "label": "2", "value": "2" }, { "label": "3", "value": "3" }, { "label": "4", "value": "4" } ] },
    { "type": "toggle", "id": "show_link", "label": "Karta bağlantı ekle", "help": "Kayıt kendi sayfasına bağlanır." },
    { "type": "text", "id": "empty_text", "label": "Boş durum metni", "placeholder": "Henüz kayıt seçilmedi." },

    { "type": "header", "label": "Renk" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması" }
  ],
  "presets": [
    {
      "name": "Seçili kayıtlar — 3 kolon",
      "settings": { "heading": "Seçili içerikler", "columns": "3", "show_link": true, "empty_text": "Henüz kayıt seçilmedi." }
    }
  ]
}
{% endschema %}
